# Firebase project settings (required for sign-in and protected pages)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Gemini API key (optional; enables both AI chat widgets)
# For production, call Gemini through a secured backend instead of exposing a key in the browser.
VITE_GEMINI_API_KEY=

# Optional backend URL; leave blank if no backend is configured.
VITE_API_BASE_URL=
